{"asset": "btcusd", "n_bars": 4388, "n_sims": 200, "seed": 101, "history_years": null, "last_date": "2026-09-21", "summary": {"passed": 7, "total": 16}, "families": [{"key": "returns", "label": "Return distribution", "blurb": "Does a simulated path have the same average move, spread and tail weight as the real asset?", "passed": 1, "total": 3}, {"key": "clustering", "label": "Volatility clustering", "blurb": "Do big moves cluster the way they do in reality? This is what GARCH is for, and the autocorrelation of squared returns is how it is measured.", "passed": 2, "total": 4}, {"key": "extremes", "label": "Extremes", "blurb": "Is the worst single bar in a simulated history as bad as the worst real one \u2014 neither tamer nor absurd?", "passed": 0, "total": 1}, {"key": "regimes", "label": "Regime mix", "blurb": "Does the Markov chain spend the same fraction of its time in the turbulent state as the HMM infers from real data?", "passed": 1, "total": 1}, {"key": "candles", "label": "Candle internals", "blurb": "Not just closes: the shape of the bars themselves \u2014 how wide, where the close sits, how much of the range the body fills. This family is expected to miss, for two reasons on record. The simulator opens every bar exactly at the previous close, so it never gaps, and its body fills ~52% of the range for every asset; and the source OHLC has intrabar pathologies the scrubber cannot see, because it works on close-to-close returns \u2014 751 of 6,096 gold bars have high equal to low, and EUR/USD's median body is 2% of its range with a third of the daily range falling between the previous close and the open. Closes, volatility and regimes are unaffected: those are what the model is fitted on.", "passed": 2, "total": 4}, {"key": "volume", "label": "Volume", "blurb": "Does modelled volume track absolute returns and persist from bar to bar as real volume does?", "passed": 1, "total": 3}], "metrics": [{"key": "mean", "label": "Mean return per bar", "family": "returns",